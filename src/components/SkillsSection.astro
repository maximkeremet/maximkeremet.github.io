---
import type { SkillCategory, Profile } from '../data/cv';
import { sortSkills } from '../data/cv';

interface Props {
  skills: SkillCategory[];
  profile: Profile;
}

const { skills, profile } = Astro.props;
---

<section>
  <h2 class="section-title">Skills</h2>
  <hr class="section-divider" />
  <div class="skills-list">
    {sortSkills(skills, profile).map(({ category, items }) => (
      <div class="skill-group">
        <div class="skill-category">{category}</div>
        <div class="skill-badges">
          {items.split(',').map((item) => (
            <span class="skill-badge">{item.trim()}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
