---
import type { Profile } from '../data/cv';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section class="hero">
  <img
    src={profile.avatarPath}
    alt={`${profile.name.first} ${profile.name.last}`}
    class="hero-avatar"
    onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
  />
  <div class="hero-avatar-placeholder" style="display:none;"></div>
  <div>
    <h1 class="hero-name">
      <span>{profile.name.first} </span><strong>{profile.name.last}</strong>
    </h1>
    <p class="hero-title">{profile.title}</p>
    <div class="hero-contacts">
      <a href={`mailto:${profile.email}`}>✉ {profile.email}</a>
      <a href={`https://github.com/${profile.github}`} target="_blank" rel="noopener">⊙ {profile.github}</a>
      <a href={`https://linkedin.com/in/${profile.linkedin}`} target="_blank" rel="noopener">in {profile.linkedin}</a>
    </div>
    <p class="hero-location">
      {profile.location} &nbsp;|&nbsp; <span>{profile.status}</span>
    </p>
  </div>
</section>
