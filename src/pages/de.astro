---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SkillsSection from '../components/SkillsSection.astro';
import RoleList from '../components/RoleList.astro';
import EducationSection from '../components/EducationSection.astro';
import { person, skills, experience, extracurricular, education, profiles } from '../data/cv';

const roleProfile = profiles.de;
---

<BaseLayout title="Maxim Keremet — Data Engineer · MLOps" roleProfile={roleProfile}>
  <Hero person={person} roleProfile={roleProfile} />
  <div class="cv-layout">
    <aside class="cv-sidebar">
      <SkillsSection skills={skills} profile={roleProfile} />
    </aside>
    <div class="cv-main">
      <RoleList title="Experience" roles={experience} profile={roleProfile} />
      <RoleList title="Extracurricular Activity" roles={extracurricular} profile={roleProfile} />
      <EducationSection education={education} />
    </div>
  </div>
</BaseLayout>
