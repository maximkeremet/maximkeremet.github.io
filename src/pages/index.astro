---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SkillsSection from '../components/SkillsSection.astro';
import RoleList from '../components/RoleList.astro';
import EducationSection from '../components/EducationSection.astro';
import { profile, skills, experience, extracurricular, education } from '../data/cv';
---

<BaseLayout title="Maxim Keremet — Data Engineer" activePage="cv">
  <Hero profile={profile} />
  <SkillsSection skills={skills} />
  <RoleList title="Experience" roles={experience} />
  <RoleList title="Extracurricular Activity" roles={extracurricular} />
  <EducationSection education={education} />
</BaseLayout>
