---
import '../styles/global.css';
import type { Profile } from '../data/cv';

interface Props {
  title: string;
  roleProfile: Profile;
}

const { title, roleProfile } = Astro.props;

const profileLinks: { id: string; label: string; href: string }[] = [
  { id: 'main', label: 'Main', href: '/' },
  { id: 'de', label: 'DE + MLOps', href: '/de' },
  { id: 'swe', label: 'SWE', href: '/swe' },
];

const downloadName = `${roleProfile.id === 'main' ? 'data_engineer' : roleProfile.id}_maxim_keremet_cv.pdf`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Maxim Keremet — Data Engineer & MLOps" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <span class="profile-switcher">
        {profileLinks.map((link, i) => (
          <>
            <a href={link.href} class={roleProfile.id === link.id ? 'active' : ''}>{link.label}</a>
            {i < profileLinks.length - 1 && <span class="profile-sep">·</span>}
          </>
        ))}
      </span>
      <span class="spacer"></span>
      <a href={`/assets/${roleProfile.pdfFilename}`} download={downloadName} class="download-btn">Download CV ↓</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
