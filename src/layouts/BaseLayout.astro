---
import '../styles/global.css';

interface Props {
  title: string;
  activePage: 'cv' | 'work' | 'projects';
}

const { title, activePage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Maxim Keremet — Data Engineer & MLOps" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <a href="/" class={activePage === 'cv' ? 'active' : ''}>CV</a>
      <a href="/work" class={activePage === 'work' ? 'active' : ''}>Work</a>
      <a href="/projects" class={activePage === 'projects' ? 'active' : ''}>Projects</a>
      <span class="spacer"></span>
      <a href="/assets/cv.pdf" download class="download-btn">Download CV ↓</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
